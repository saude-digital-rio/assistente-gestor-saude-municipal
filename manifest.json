{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "Assistente de Gestor de Saúde Municipal",
  "version": "1.0.0",
  "description": "Exporta relatórios do SISAB, SIA e SI-PNI para um ZIP.",
  "homepage_url": "https://github.com/saude-digital-rio/e-gestor-helper",
  "permissions": ["tabs", "scripting", "downloads", "sidePanel"],
  "host_permissions": [
    "https://egestorab.saude.gov.br/*",
    "https://sisab.saude.gov.br/*",
    "https://tabnet.rio.rj.gov.br/*"
  ],
  "action": {
    "default_title": "Assistente de Gestor de Saúde Municipal",
    "default_icon": { "16": "icons/blue16.png", "32": "icons/blue32.png" }
  },
  "side_panel": { "default_path": "popup.html" },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/blue16.png", "32": "icons/blue32.png", "48": "icons/blue48.png", "128": "icons/blue128.png" }
}
